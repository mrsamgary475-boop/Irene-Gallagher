# Discord Bot Configuration
DISCORD_TOKEN=your_discord_bot_token_here
BOT_PREFIX=!
DISCORD_SERVER_TAG=KIN
DISCORD_BOT_NICKNAME=Irene

# Kindroid Configuration
KINDROID_CODE=your_kindroid_character_code_here
KINDROID_API_KEY=your_kindroid_api_key_here
KINDROID_API_BASE=https://api.kindroid.ai
KINDROID_AI_ID=your_kindroid_ai_id_here
KINDROID_VOICE_REFERENCE=audio/irene_kindroid_sample.mp3
KINDROID_USE_LOCAL_MODEL=0

# Optional behavior flags
KINDROID_BRIDGE_MODE=1
KINDROID_BRIDGE_CHANNEL_IDS=
AUTO_REPLY_MODE=mentioned
KINDROID_MEMORY_TURNS=20
KINDROID_MEMORY_FILE=conversations.json

# Voice and speech
STT_ENGINE=google
VOICE_MIC_RECV_ENABLED=1
VOICE_MESSAGES_ENABLED=1
TTS_ENGINE=coqui
TTS_VOICE=en-US-AriaNeural
COQUI_TTS_MODEL=tts_models/multilingual/multi-dataset/xtts_v2
TTS_DEVICE=cpu
COQUI_TOS_AGREED=1
# OPENAI_API_KEY=
# OPENAI_STT_MODEL=gpt-4o-mini-transcribe

# Optional local browser interface
LOCAL_WEB_HOST=127.0.0.1
LOCAL_WEB_PORT=8765
LOCAL_AVATAR_VIDEO=avatar/live/user_avatar.mp4
LOCAL_AVATAR_IMAGE=avatar/live/irene_photo.png
# CPU-friendly browser motion driver; avoids heavy LivePortrait/LivePortrait weights.
LOCAL_AVATAR_MODE=cpu_lite
# For Android on the same Wi-Fi, run android_launch.bat (it uses 0.0.0.0).
# Camera and microphone require HTTPS outside localhost:
# LOCAL_WEB_CERT_FILE=
# LOCAL_WEB_KEY_FILE=

# Optional Android SMS relay. Set a private random value and enter the same
# value in the Irene SMS Relay Android app.
SMS_DEVICE_TOKEN=
